{
	"angularCompilerOptions": {
		"enableI18nLegacyMessageIdFormat": false,
		"strictInjectionParameters": true,
		"strictTemplates": true
	},
	"compilerOptions": {
		"allowJs": true,
		"allowSyntheticDefaultImports": true,
		"declaration": true,
		"emitDecoratorMetadata": true,
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"forceConsistentCasingInFileNames": true,
		"incremental": true,
		"jsx": "react-jsx",
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noImplicitAny": true,
		"noUncheckedIndexedAccess": true,
		"outDir": "dist",
		"rootDir": ".",
		"skipLibCheck": true,
		"strict": true,
		"target": "ESNext",
		"tsBuildInfoFile": ".absolutejs/tsconfig.tsbuildinfo",
		"useDefineForClassFields": false
	},
	"exclude": [
		"node_modules",
		"build",
		"**/build/**",
		"example/build",
		"example/dist",
		"**/generated/**"
	],
	// `**/build/**` above also excludes `src/build/`; those modules are
	// still checked because `src/index.ts` imports them — except the worker
	// entry, which nothing imports, so it is listed explicitly.
	"files": ["src/build/buildWorker.ts"],
	"include": [
		"src/**/*",
		"types/**/*",
		"example/**/*",
		"benchmarks/**/*",
		"tests/**/*",
		"test/**/*",
		"scripts/**/*"
	]
}
